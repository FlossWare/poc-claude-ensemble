[Unit]
Description=Learning Service - Central learning authority for task outcome recording
Documentation=file://%h/.config/systemd/user/claude-learning.service.d/README.md
After=network.target claude-thompson.service
Wants=claude-thompson.service

[Service]
Type=simple
ExecStart=/usr/bin/env python3 %REPO_PATH%/learning-service/learning_service.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=claude-ensemble-learning-service

# Optional per-user portable configuration.
EnvironmentFile=-%h/.config/claude-ensemble/environment

# Environment
Environment="PATH=%h/.local/bin:%REPO_PATH%/tools:/usr/local/bin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"

# Resource limits
MemoryLimit=512M
CPUQuota=50%

[Install]
WantedBy=default.target
