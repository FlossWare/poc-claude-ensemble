[Unit]
Description=Thompson Router Service - Model selection authority via Thompson Sampling
Documentation=file://%h/.config/systemd/user/claude-thompson.service.d/README.md
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/env python3 %REPO_PATH%/thompson-service/thompson_service.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=claude-ensemble-thompson-service

# Optional per-user portable configuration.
EnvironmentFile=-%h/.config/claude-ensemble/environment

# Environment
Environment="PATH=%h/.local/bin:%REPO_PATH%/tools:/usr/local/bin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"

# Resource limits
MemoryLimit=256M
CPUQuota=25%

[Install]
WantedBy=default.target
