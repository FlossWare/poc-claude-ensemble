{
  "env": {
    "CLAUDE_CODE_USE_VERTEX": "1",
    "ANTHROPIC_VERTEX_PROJECT_ID": "itpc-ca-8511bbc2b2",
    "CLOUD_ML_REGION": "global",
    "JIRA_API_TOKEN": "${JIRA_API_TOKEN}",
    "GITLAB_TOKEN": "${GITLAB_TOKEN}",
    "GOOGLE_API_KEY": "${GOOGLE_API_KEY}",
    "CURSOR_API_KEY": "${CURSOR_API_KEY}",
    "SONAR_TOKEN": "${SONAR_TOKEN}",
    "SUMO_ACCESS_ID": "${SUMO_ACCESS_ID}",
    "SUMO_ACCESS_KEY": "${SUMO_ACCESS_KEY}",
    "GA_TUNING_CACHE_TTL": "246.87",
    "GA_TUNING_CACHE_THRESHOLD": "0.44"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/memory-search-on-prompt.js",
            "statusMessage": "Searching Claude Ensemble context...",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/session-end-memory-capture.js",
            "statusMessage": "Capturing session event...",
            "async": false,
            "timeout": 3
          }
        ]
      }
    ]
  },
  "tui": "fullscreen",
  "theme": "dark",
  "tools": {
    "compression": {
      "enabled": true,
      "description": "Token reduction via semantic compression (64.6% reduction)"
    },
    "caching": {
      "enabled": true,
      "description": "Prompt caching with metrics tracking (69.8% savings) — TTL increased to 3600s for better reuse"
    },
    "ga_tuning": {
      "enabled": true,
      "description": "Genetic algorithm parameter optimization (Sunday 2 AM)"
    },
    "thompson_router": {
      "enabled": true,
      "description": "Dynamic model selection based on task type (67% cost savings)"
    },
    "cost_tracking": {
      "enabled": true,
      "description": "Daily/weekly/monthly cost aggregation (JSONL log)"
    },
    "learning": {
      "enabled": true,
      "description": "Thompson continuous self-improvement from outcomes"
    }
  },
  "features": {
    "always_load_memory": {
      "enabled": true,
      "description": "Load memory at start of every response"
    },
    "multi_model_consensus": {
      "enabled": true,
      "description": "Multi-AI voting for critical decisions (arbiter pattern)"
    },
    "autonomous_learning": {
      "enabled": true,
      "description": "Autonomous learning from task outcomes"
    }
  },
  "skipWorkflowUsageWarning": true
}
