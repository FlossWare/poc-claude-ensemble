[Unit]
Description=Claude Ensemble session messaging service
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/env python3 %REPO_PATH%/session-messaging/messenger_service.py
Restart=on-failure
RestartSec=1
RuntimeDirectory=claude-messenger
RuntimeDirectoryMode=0700
Environment=CLAUDE_MESSENGER_SOCKET=%t/claude-messenger/claude-messenger.sock

[Install]
WantedBy=default.target
