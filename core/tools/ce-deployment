#!/usr/bin/env bash
# Manage versioned standalone Claude Ensemble releases.
#
# This helper deliberately uses the stable logical path "$ROOT/current" when
# validating or activating service units. Unit files must reference that path,
# never a resolved releases/<version> directory.
set -Eeuo pipefail

FLOSSWARE_HOME="$HOME/.FlossWare"
if [[ -L "$FLOSSWARE_HOME" ]]; then
  printf 'ERROR: %s must be a real directory, not a symlink. Resolve the path explicitly before managing releases.\n' "$FLOSSWARE_HOME" >&2
  exit 1
fi

ROOT="${ENSEMBLE_INSTALL_ROOT:-$HOME/.FlossWare/claude-ensemble}"
SYSTEMCTL_BIN="${ENSEMBLE_SYSTEMCTL_BIN:-systemctl}"
UNIT_DIR="${ENSEMBLE_USER_UNIT_DIR:-$HOME/.config/systemd/user}"
case "$ROOT" in "~") ROOT="$HOME";; "~/"*) ROOT="$HOME/${ROOT#\~/}";; esac
ROOT="${ROOT%/}"
command -v python3 >/dev/null 2>&1 || {
  printf 'ERROR: python3 is required to validate the deployment path.\n' >&2
  exit 1
}
[[ ! -L "$ROOT" ]] || {
  printf 'ERROR: Install root must not be a symlink: %s\n' "$ROOT" >&2
  exit 1
}
HOME_REAL="$(cd -- "$HOME" && pwd -P)"
ROOT="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$ROOT")"
case "$ROOT" in
  "$HOME_REAL"/*) ;;
  *)
    printf 'ERROR: Deployment path must resolve to a child of HOME: %s\n' "$ROOT" >&2
    exit 1
    ;;
esac
ROOT_BASE="$(basename -- "$ROOT")"
[[ -n "$ROOT_BASE" && "$ROOT_BASE" != "." && "$ROOT_BASE" != ".." ]] || {
  printf 'ERROR: Deployment root must name a child directory: %s\n' "$ROOT" >&2
  exit 1
}
ROOT_PARENT="$(dirname -- "$ROOT")"
mkdir -p -- "$ROOT_PARENT"
ROOT_PARENT="$(cd -- "$ROOT_PARENT" && pwd -P)"
ROOT="$ROOT_PARENT/$ROOT_BASE"
case "$ROOT" in
  "$HOME_REAL"/*) ;;
  *)
    printf 'ERROR: Deployment path must resolve to a child of HOME: %s\n' "$ROOT" >&2
    exit 1
    ;;
esac
[[ ! -L "$ROOT" ]] || { printf 'ERROR: Install root must not be a symlink: %s\\n' "$ROOT" >&2; exit 1; }
RELEASES="$ROOT/releases"
CURRENT="$ROOT/current"
KNOWN_GOOD="$ROOT/known-good.json"
UNITS=(claude-memory.service claude-thompson.service claude-learning.service claude-graph.service claude-ensemble.service)
LEGACY_UNITS=(claude-alert.service claude-messenger.service)
ALL_UNITS=(${UNITS[@]} ${LEGACY_UNITS[@]})
STOP_ORDER=(claude-ensemble.service claude-graph.service claude-learning.service claude-thompson.service claude-memory.service claude-messenger.service claude-alert.service)
START_ORDER=(claude-memory.service claude-thompson.service claude-learning.service claude-graph.service claude-ensemble.service)

die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
valid_version() { [[ "$1" =~ ^[0-9]+\.[0-9]+$ ]]; }
active_version() {
  [[ -L "$CURRENT" ]] || return 1
  local target version
  target="$(readlink -- "$CURRENT")"
  [[ "$target" =~ ^releases/([0-9]+\.[0-9]+)$ ]] || return 1
  version="${BASH_REMATCH[1]}"
  [[ -d "$RELEASES/$version" && ! -L "$RELEASES/$version" ]] || return 1
  printf '%s\n' "$version"
}
preflight_units() {
  local version="$1" temp installer
  local installers=(
    memory-service/install.sh
    thompson-service/install.sh
    learning-service/install.sh
    graph-service/install.sh
    server/install.sh
  )
  temp="$(mktemp -d "${TMPDIR:-/tmp}/ce-unit-preflight.XXXXXX")" || die "could not create unit preflight directory"
  for installer in "${installers[@]}"; do
    if ! SYSTEMCTL_BIN=true ENSEMBLE_STANDALONE_INSTALL=1 \
      ENSEMBLE_USER_UNIT_DIR="$temp" \
      ENSEMBLE_CLAUDE_CODE_CONFIG_DIR="$ROOT/shared/claude-code" \
      ENSEMBLE_DEFER_SERVICE_START=1 \
      bash "$RELEASES/$version/$installer"; then
      rm -rf -- "$temp"
      die "unit preflight failed while running $installer"
    fi
  done
  if ! python3 "$RELEASES/$version/tools/managed_unit_config.py" configure \
    "$temp" "$ROOT" "$CURRENT" "$RELEASES/$version"; then
    rm -rf -- "$temp"
    die "generated service units failed preflight for release $version"
  fi
  rm -rf -- "$temp"
}

stop_services() {
  local unit
  for unit in "${STOP_ORDER[@]}"; do "$SYSTEMCTL_BIN" --user stop "$unit" >/dev/null 2>&1 || true; done
  for unit in "${ALL_UNITS[@]}"; do
    if "$SYSTEMCTL_BIN" --user is-active --quiet "$unit"; then
      printf 'ERROR: service remained active after stop: %s\n' "$unit" >&2
      return 1
    fi
  done
}
start_services() {
  local unit
  # Re-run the canonical installer through the stable logical path after
  # switching current. Its service installers then render units against current,
  # while all mutable Claude configuration remains in shared/.
  ENSEMBLE_STANDALONE_INSTALL=1 \
    ENSEMBLE_INSTALL_ROOT="$ROOT" \
    ENSEMBLE_USER_UNIT_DIR="$UNIT_DIR" \
    ENSEMBLE_CLAUDE_CODE_CONFIG_DIR="$ROOT/shared/claude-code" \
    ENSEMBLE_MEMORY_DIR="$ROOT/shared/data/memory" \
    ENSEMBLE_LEARNING_DIR="$ROOT/shared/data/learning" \
    ENSEMBLE_THOMPSON_STATE_FILE="$ROOT/shared/data/thompson-sampling-state.json" \
    ENSEMBLE_GRAPH_STORE="$ROOT/shared/data/graph.json" \
    ENSEMBLE_LOG_DIR="$ROOT/shared/logs" \
    ENSEMBLE_RUNTIME_DIR="$ROOT/shared/runtime" \
    ENSEMBLE_DEFER_SERVICE_START=1 \
    bash "$CURRENT/install.sh" "$CURRENT"
  # Keep managed deployment state out of the development profile and global config.
  mkdir -p "$ROOT/shared/config" "$ROOT/shared/data/memory" "$ROOT/shared/data/learning" \
    "$ROOT/shared/logs" "$ROOT/shared/runtime"
  for unit in "${LEGACY_UNITS[@]}"; do rm -f -- "$UNIT_DIR/$unit"; done
  python3 "$CURRENT/tools/managed_unit_config.py" configure "$UNIT_DIR" "$ROOT" "$CURRENT"
  local unit file
  for unit in "${UNITS[@]}"; do
    file="$UNIT_DIR/$unit"
    [[ -f "$file" ]] || { printf 'ERROR: generated unit is missing: %s\n' "$unit" >&2; return 1; }
    grep -Fq "$CURRENT" "$file" || { printf 'ERROR: unit does not use stable current path: %s\n' "$unit" >&2; return 1; }
    if grep -Eq 'releases/[0-9]+\.[0-9]+' "$file"; then
      printf 'ERROR: unit pins a release directory: %s\n' "$unit" >&2
      return 1
    fi
  done
  "$SYSTEMCTL_BIN" --user daemon-reload
  for unit in "${START_ORDER[@]}"; do "$SYSTEMCTL_BIN" --user start "$unit"; done
  for unit in "${UNITS[@]}"; do
    "$SYSTEMCTL_BIN" --user is-active --quiet "$unit" || {
      printf 'ERROR: service failed to become active: %s\n' "$unit" >&2
      return 1
    }
  done
  # The gateway readiness endpoint verifies application/dependency health, not
  # merely systemd process liveness.
  python3 - <<'PY'
import time
import urllib.error
import urllib.request

url = __import__("os").environ.get("ENSEMBLE_READY_URL", "http://127.0.0.1:8080/api/v1/ready")
deadline = time.monotonic() + 20
last_error = "readiness endpoint did not become ready"
while time.monotonic() < deadline:
    try:
        with urllib.request.urlopen(url, timeout=2) as response:
            if response.status == 200:
                raise SystemExit(0)
            last_error = f"HTTP {response.status}"
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        last_error = str(exc)
    time.sleep(0.5)
raise SystemExit(f"gateway readiness failed: {last_error}")
PY
}
switch_link() {
  local version="$1" tmp="$ROOT/.current.$$"
  ln -s "releases/$version" "$tmp"
  mv -Tf -- "$tmp" "$CURRENT"
}
validate_release() {
  local version="$1" release="$RELEASES/$1" unit
  valid_version "$version" || die "release version must be MAJOR.MINOR, got: $version"
  [[ -d "$release" && ! -L "$release" && -f "$release/install.sh" ]] || die "release is incomplete or is a symlink: $release"
  [[ ! -e "$release/.git" && ! -L "$release/.git" ]] || die "release contains Git metadata: $release"
  if find "$release" -type l -print0 | while IFS= read -r -d '' link; do
      resolved="$(readlink -f -- "$link" 2>/dev/null || true)"
      [[ -n "$resolved" ]] || exit 1
      # A release may link only to its own immutable tree or shared mutable
      # state. Links into another release create hidden cross-version coupling;
      # links elsewhere in HOME or the host filesystem are rejected.
      case "$resolved" in "$release"/*|"$ROOT/shared"/*) ;; *) exit 1;; esac
    done; then :; else die "release contains broken links or links into development checkouts"; fi
}
JOURNAL="$ROOT/activation.json"
BACKUPS="$ROOT/shared/activation-backups"

assert_managed_layout() {
  local path
  for path in \
    "$RELEASES" "$ROOT/shared" "$ROOT/shared/claude-code" "$ROOT/shared/config" \
    "$ROOT/shared/data" "$ROOT/shared/data/memory" "$ROOT/shared/data/learning" \
    "$ROOT/shared/runtime" "$ROOT/shared/logs" "$BACKUPS"; do
    [[ ! -L "$path" ]] || die "managed deployment path must not be a symlink: $path"
    [[ ! -e "$path" || -d "$path" ]] || die "managed deployment path is not a directory: $path"
  done
  path="$ROOT/shared/config/environment"
  [[ ! -L "$path" ]] || die "managed service environment must not be a symlink: $path"
  [[ ! -e "$path" || -f "$path" ]] || die "managed service environment is not a regular file: $path"
}
assert_managed_layout

write_deployment_manifest() {
  local version="$1" tmp="$ROOT/.deployment.json.$BASHPID"
  python3 - "$RELEASES/$version/.ce-release.json" "$ROOT/deployment.json" "$tmp" "$version" <<'PY'
import datetime, json, os, re, sys
release_path, current_path, output_path, version = sys.argv[1:]
if not re.fullmatch(r"[0-9]+\.[0-9]+", version):
    raise SystemExit("invalid deployment release version")
if os.path.isfile(release_path) and not os.path.islink(release_path):
    with open(release_path, encoding="utf-8") as source:
        metadata = json.load(source)
    if metadata.get("schema_version") != 1 or metadata.get("release") != version:
        raise SystemExit("release provenance metadata does not match the activated release")
    commit = metadata.get("source_commit")
    if not isinstance(commit, str) or not re.fullmatch(r"[0-9a-f]{40}", commit):
        raise SystemExit("release provenance metadata has an invalid source commit")
    created_at = metadata.get("created_at")
    if not isinstance(created_at, str) or not created_at:
        raise SystemExit("release provenance metadata has no creation timestamp")
else:
    commit = None
    created_at = datetime.datetime.now(datetime.timezone.utc).isoformat()
    if os.path.isfile(current_path) and not os.path.islink(current_path):
        with open(current_path, encoding="utf-8") as source:
            current = json.load(source)
        if current.get("schema_version") == 1 and current.get("release") == version:
            candidate = current.get("source_commit")
            if candidate is None or (isinstance(candidate, str) and re.fullmatch(r"[0-9a-f]{40}", candidate)):
                commit = candidate
                created_at = current.get("created_at", created_at)
payload = {"schema_version": 1, "release": version, "source_commit": commit,
           "created_at": created_at, "validation": "activated"}
with open(output_path, "w", encoding="utf-8") as target:
    json.dump(payload, target, indent=2)
    target.write("\n")
os.replace(output_path, os.path.join(os.path.dirname(output_path), "deployment.json"))
PY
}

write_known_good() {
  local previous="$1" target="$2" tmp="$ROOT/.known-good.json.$BASHPID"
  python3 - "$tmp" "$previous" "$target" <<'PY'
import json, os, re, sys
path, previous, target = sys.argv[1:]
for version in (previous, target):
    if version and not re.fullmatch(r"[0-9]+\.[0-9]+", version):
        raise SystemExit("invalid known-good release version")
with open(path, "w", encoding="utf-8") as out:
    json.dump({"schema_version": 1, "active": target, "previous": previous or None}, out, indent=2)
    out.write("\n")
os.replace(path, os.path.join(os.path.dirname(path), "known-good.json"))
PY
}

known_good_field() {
  local field="$1"
  [[ -f "$KNOWN_GOOD" ]] || return 1
  python3 - "$KNOWN_GOOD" "$field" <<'PY'
import json, re, sys
with open(sys.argv[1], encoding="utf-8") as source: data = json.load(source)
if data.get("schema_version") != 1: raise SystemExit("unsupported known-good state schema")
field = sys.argv[2]; value = data.get(field)
if field == "active":
    if not isinstance(value, str) or not re.fullmatch(r"[0-9]+\.[0-9]+", value): raise SystemExit("invalid active release in known-good state")
elif field == "previous":
    if value is not None and (not isinstance(value, str) or not re.fullmatch(r"[0-9]+\.[0-9]+", value)): raise SystemExit("invalid previous release in known-good state")
else: raise SystemExit("invalid known-good field")
print(value or "")
PY
}

write_journal() {
  local previous="$1" target="$2" backup="$3" active_file="$4" tmp="$ROOT/.activation.json.${BASHPID}"
  python3 - "$tmp" "$previous" "$target" "$backup" "$active_file" <<'PY'
import json, os, sys
path, previous, target, backup, active_file = sys.argv[1:]
payload = {"schema_version": 1, "previous": previous or None, "target": target, "unit_backup": backup, "active_before_file": active_file}
with open(path, "w", encoding="utf-8") as out:
    json.dump(payload, out, indent=2)
    out.write("\n")
os.replace(path, os.path.join(os.path.dirname(path), "activation.json"))
PY
}

load_journal() {
  [[ -f "$JOURNAL" ]] || die "no interrupted activation journal exists"
  python3 - "$JOURNAL" "$ROOT" <<'PY'
import json, os, sys
path, root = sys.argv[1:]
with open(path, encoding="utf-8") as source: data = json.load(source)
backup = os.path.realpath(data.get("unit_backup", ""))
allowed = os.path.realpath(os.path.join(root, "shared", "activation-backups")) + os.sep
if not backup.startswith(allowed) or not os.path.isdir(backup):
    raise SystemExit("activation journal references an invalid/missing backup directory")
previous, target = data.get("previous"), data.get("target")
for version in (previous, target):
    if version is not None and (not isinstance(version, str) or not __import__("re").fullmatch(r"[0-9]+\.[0-9]+", version)):
        raise SystemExit("activation journal contains an invalid release version")
active_file = data.get("active_before_file")
expected_active_file = os.path.join(backup, "active-before.txt")
if active_file != expected_active_file or not os.path.isfile(active_file):
    raise SystemExit("activation journal is missing valid active-service state")
allowed_units = {"claude-memory.service", "claude-thompson.service", "claude-learning.service", "claude-alert.service", "claude-messenger.service", "claude-graph.service", "claude-ensemble.service"}
with open(active_file, encoding="utf-8") as source:
    if any(line.rstrip("\n") not in allowed_units for line in source):
        raise SystemExit("active-service state contains an unknown unit")
print(json.dumps(data))
PY
}

restore_units() {
  local backup="$1" active_file="$2" unit file
  for unit in "${ALL_UNITS[@]}"; do
    file="$UNIT_DIR/$unit"
    if [[ -e "$backup/$unit" || -L "$backup/$unit" ]]; then cp -a -- "$backup/$unit" "$file"; else rm -f -- "$file"; fi
  done
  "$SYSTEMCTL_BIN" --user daemon-reload
  while IFS= read -r unit; do [[ -n "$unit" ]] && "$SYSTEMCTL_BIN" --user start "$unit"; done < "$active_file"
}

recover_activation() {
  local data previous target backup active_file
  data="$(load_journal)" || die "cannot safely recover; fix journal/backup then retry"
  previous="$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("previous") or "")' <<< "$data")"
  target="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["target"])' <<< "$data")"
  backup="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["unit_backup"])' <<< "$data")"
  active_file="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["active_before_file"])' <<< "$data")"
  # Validate the rollback target before stopping anything or switching current.
  # The journal is durable state, not proof that the referenced release is safe.
  if [[ -n "$previous" ]]; then
    validate_release "$previous" || die "previous release $previous is not safe to recover; activation journal retained"
  fi
  stop_services || die "services could not be stopped; activation journal retained"
  if [[ -n "$previous" ]]; then
    switch_link "$previous"
    start_services || die "previous release $previous selected but health checks failed; journal retained"
  else
    rm -f -- "$CURRENT"
    restore_units "$backup" "$active_file" || die "original unit restoration failed; journal retained"
  fi
  if [[ -f "$backup/known-good-before.json" ]]; then cp -a -- "$backup/known-good-before.json" "$KNOWN_GOOD"; elif [[ -f "$backup/known-good-before.absent" ]]; then rm -f -- "$KNOWN_GOOD"; fi
  if [[ -f "$backup/deployment-before.json" ]]; then cp -a -- "$backup/deployment-before.json" "$ROOT/deployment.json"; elif [[ -f "$backup/deployment-before.absent" ]]; then rm -f -- "$ROOT/deployment.json"; fi
  rm -f -- "$JOURNAL"
  rm -rf -- "$backup"
  rm -f -- "$active_file"
  printf "Recovered interrupted activation of %s; restored %s.\n" "$target" "${previous:-no prior release}"
}
cmd="${1:-help}"

# All deployment mutations share one advisory lock. Keep it beside the install
# root, not inside it: uninstall --purge removes ROOT, and deleting the lock
# inode while held would let a second process lock a newly-created inode.
case "$cmd" in
  activate|rollback|recover|prune|uninstall)
    if [[ "${FLOSSWARE_DEPLOYMENT_LOCK_HELD:-0}" != "1" ]]; then
      command -v flock >/dev/null 2>&1 || die "flock is required to serialize deployment mutations"
      LOCK_FILE="$ROOT_PARENT/.${ROOT_BASE}.deployment.lock"
      exec 9>"$LOCK_FILE"
      flock -x 9 || die "could not acquire deployment mutation lock"
      export FLOSSWARE_DEPLOYMENT_LOCK_HELD=1
    fi
    ;;
esac

case "$cmd" in
  uninstall)
    [[ $# -le 2 ]] || die "usage: ce-deployment uninstall [--purge]"
    purge=0
    if [[ $# -eq 2 ]]; then
      [[ "$2" == "--purge" ]] || die "usage: ce-deployment uninstall [--purge]"
      purge=1
    fi
    [[ ! -e "$JOURNAL" ]] || die "interrupted activation journal exists; run ce-deployment recover first"
    if [[ -e "$CURRENT" || -L "$CURRENT" ]]; then
      active="$(active_version)" || die "current symlink is invalid; refusing uninstall"
    fi
    # Fail before changing services or unit files if the user manager is unavailable.
    "$SYSTEMCTL_BIN" --user show-environment >/dev/null 2>&1 || die "systemd user manager is unavailable; deployment left unchanged"
    # Stop the five current CE services and retire legacy Alert/Messenger units.
    # Default uninstall preserves immutable releases and all shared user data.
    stop_services || die "CE services could not be stopped; deployment retained"
    for unit in "${ALL_UNITS[@]}"; do
      rm -f -- "$UNIT_DIR/$unit"
    done
    "$SYSTEMCTL_BIN" --user daemon-reload || die "systemd user manager could not reload after removing CE units"
    rm -f -- "$CURRENT" "$KNOWN_GOOD"
    if [[ "$purge" == "1" ]]; then
      [[ "$ROOT" == "$HOME_REAL/"* ]] || die "refusing to purge a deployment outside HOME"
      [[ ! -L "$ROOT" ]] || die "refusing to purge a symlinked deployment root"
      rm -rf -- "$ROOT"
      printf 'Uninstalled Claude Ensemble and purged releases/shared data at %s.\n' "$ROOT"
    else
      printf 'Uninstalled active Claude Ensemble services. Releases and shared data were preserved at %s.\n' "$ROOT"
      printf 'To permanently delete those releases and user data, explicitly run: ce-deployment uninstall --purge\n'
    fi
    ;;
  validate)
    [[ $# -eq 2 ]] || die "usage: ce-deployment validate MAJOR.MINOR"
    validate_release "$2"
    preflight_units "$2"
    printf 'Release %s and its generated service units passed validation.\n' "$2"
    ;;
  activate)
    [[ $# -eq 2 ]] || die "usage: ce-deployment activate MAJOR.MINOR"
    [[ ! -e "$JOURNAL" ]] || die "interrupted activation journal exists; run ce-deployment recover first"
    version="$2"
    validate_release "$version"
    preflight_units "$version"
    assert_managed_layout
    if [[ -e "$CURRENT" || -L "$CURRENT" ]]; then
      previous="$(active_version)" || die "current symlink is invalid; refusing activation"
    else
      previous=""
    fi
    if [[ -f "$KNOWN_GOOD" ]]; then
      recorded_active="$(known_good_field active)" || die "known-good state is invalid"
      [[ "$recorded_active" == "$previous" ]] || die "current release ${previous:-none} does not match known-good state $recorded_active; recover or reconcile deployment state first"
    fi
    "$SYSTEMCTL_BIN" --user show-environment >/dev/null 2>&1 || die "systemd user manager is unavailable; deployment left unchanged"
    mkdir -p "$RELEASES" "$ROOT/shared/claude-code" "$ROOT/shared/config" "$ROOT/shared/data" "$ROOT/shared/logs" "$BACKUPS"
    assert_managed_layout
    [[ "$previous" != "$version" ]] || { printf "Release %s is already active.\n" "$version"; exit 0; }
    backup="$BACKUPS/activation.$(date +%Y%m%d%H%M%S).$$"
    mkdir -m 700 "$backup"
    active_file="$backup/active-before.txt"
    : > "$active_file"
    for unit in "${ALL_UNITS[@]}"; do
      file="$UNIT_DIR/$unit"
      if [[ -e "$file" || -L "$file" ]]; then cp -a -- "$file" "$backup/$unit"; fi
      "$SYSTEMCTL_BIN" --user is-active --quiet "$unit" && printf "%s\n" "$unit" >> "$active_file" || true
    done
    if [[ -f "$KNOWN_GOOD" ]]; then cp -a -- "$KNOWN_GOOD" "$backup/known-good-before.json"; else : > "$backup/known-good-before.absent"; fi
    if [[ -f "$ROOT/deployment.json" ]]; then cp -a -- "$ROOT/deployment.json" "$backup/deployment-before.json"; else : > "$backup/deployment-before.absent"; fi
    write_journal "$previous" "$version" "$backup" "$active_file"
    [[ -f "$JOURNAL" ]] || die "failed to persist activation journal at $JOURNAL"
    stop_services || die "could not stop all CE services; run ce-deployment recover; journal retained"
    if ! switch_link "$version"; then
      restore_units "$backup" "$active_file" || die "switch failed and unit restoration failed; journal retained"
      rm -f -- "$JOURNAL"; rm -rf -- "$backup"
      die "atomic current symlink switch failed; prior unit files restored"
    fi
    if start_services; then
      write_known_good "$previous" "$version" || die "activation succeeded but known-good state could not be persisted; journal retained"
      write_deployment_manifest "$version" || die "activation succeeded but deployment manifest could not be persisted; journal retained"
      rm -f -- "$JOURNAL"; rm -rf -- "$backup"
      printf "Activated Claude Ensemble release %s. Previous release: %s\n" "$version" "${previous:-none}"
      exit 0
    fi
    printf "Activation failed; restoring previous release.\n" >&2
    stop_services || die "failed activation left services running; inspect status and run recover"
    if [[ -n "$previous" ]]; then
      switch_link "$previous"
      start_services || die "rollback selected $previous but health checks failed; activation journal retained"
    else
      rm -f -- "$CURRENT"
      restore_units "$backup" "$active_file" || die "original unit restoration failed; activation journal retained"
    fi
    rm -f -- "$JOURNAL"
    rm -rf -- "$backup"
    exit 1
    ;;
  recover)
    [[ $# -eq 1 ]] || die "usage: ce-deployment recover"
    recover_activation
    ;;
  rollback)
    active="$(active_version)" || die "no active release"
    [[ -f "$KNOWN_GOOD" ]] || die "no known-good activation history; activate a release successfully before rollback"
    recorded_active="$(known_good_field active)" || die "known-good state is invalid"
    [[ "$recorded_active" == "$active" ]] || die "current release $active does not match known-good state $recorded_active; recover or reconcile deployment state first"
    target="$(known_good_field previous)" || die "known-good state is invalid"
    [[ -n "$target" ]] || die "no previous known-good release is recorded"
    [[ -d "$RELEASES/$target" ]] || die "previous known-good release is missing: $target"
    bash "$0" activate "$target"
    ;;
  status)
    if [[ -e "$JOURNAL" ]]; then printf "WARNING: interrupted activation journal exists; run ce-deployment recover.\n" >&2; fi
    printf 'Root: %s\n' "$ROOT"
    printf 'Current: %s\n' "$(active_version || printf 'not activated')"
    printf 'Releases:\n'
    find "$RELEASES" -mindepth 1 -maxdepth 1 -type d -printf '  %f\n' 2>/dev/null | sort -V || true
    ;;
  prune)
    [[ ! -e "$JOURNAL" ]] || die "interrupted activation journal exists; run ce-deployment recover first"
    active="$(active_version)" || die "no active release"
    [[ -f "$KNOWN_GOOD" ]] || die "no known-good activation history; refusing to prune"
    recorded_active="$(known_good_field active)" || die "known-good state is invalid"
    [[ "$recorded_active" == "$active" ]] || die "current release $active does not match known-good state $recorded_active; refusing to prune"
    previous="$(known_good_field previous)" || die "known-good state is invalid"
    for dir in "$RELEASES"/*; do
      [[ -d "$dir" ]] || continue
      version="${dir##*/}"
      if [[ "$version" != "$active" && "$version" != "$previous" ]]; then
        printf 'Removing old release %s\\n' "$version"
        rm -rf -- "$dir"
      fi
    done
    ;;
  help|--help|-h)
    cat <<'USAGE'
Usage: ce-deployment COMMAND [MAJOR.MINOR]
Commands:
  validate VERSION  Validate a staged release and stable service-unit paths.
  activate VERSION  Stop services, atomically switch current, restart and health-check.
  rollback          Activate the highest version other than the current one.
  status            Show active and retained release versions.
  prune             Keep active and highest other release; remove older releases.
USAGE
    ;;
  *) die "unknown command: $cmd" ;;
esac