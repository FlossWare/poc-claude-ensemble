#!/usr/bin/env bash
set -Eeuo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

usage() {
  cat <<'EOF'
Claude Ensemble
  tools/ce doctor [--verbose|--json]
  tools/ce diagnose [--deep] [--service NAME] [--json]
  tools/ce dev setup                 Create an isolated Python venv, profile, and state root
  eval "$(tools/ce dev env)"         Export isolated development paths into this shell
  tools/ce dev run SERVICE           Run one foreground service: memory|thompson|learning|graph|gateway
EOF
}

dev_paths() {
  CE_PROFILE="${ENSEMBLE_CE_DEV_PROFILE:-$HOME/.FlossWare/claude-ensemble-profile}"
  CE_STATE="${ENSEMBLE_CE_DEV_STATE:-$HOME/.FlossWare/claude-ensemble-state}"
  CE_VENV="${ENSEMBLE_CE_DEV_VENV:-$HOME/.FlossWare/venvs/claude-ensemble}"
  [[ ! -L "$CE_PROFILE" ]] || { echo "ERROR: CE profile path must not be a symlink: $CE_PROFILE" >&2; return 2; }
  [[ ! -L "$CE_STATE" ]] || { echo "ERROR: CE state root must not be a symlink: $CE_STATE" >&2; return 2; }
  [[ ! -L "$CE_VENV" ]] || { echo "ERROR: CE virtualenv path must not be a symlink: $CE_VENV" >&2; return 2; }
}

dev_exports() {
  dev_paths
  local memory_port graph_port gateway_port
  memory_port="${ENSEMBLE_CE_DEV_MEMORY_PORT:-18767}"
  graph_port="${ENSEMBLE_CE_DEV_GRAPH_PORT:-18766}"
  gateway_port="${ENSEMBLE_CE_DEV_GATEWAY_PORT:-18080}"
  printf 'export ENSEMBLE_REPO_ROOT=%q\n' "$ROOT"
  printf 'export ENSEMBLE_RUNTIME_DIR=%q\n' "$CE_STATE/runtime"
  printf 'export ENSEMBLE_LOG_DIR=%q\n' "$CE_STATE/logs"
  printf 'export ENSEMBLE_CLAUDE_CODE_CONFIG_DIR=%q\n' "$CE_PROFILE"
  printf 'export CLAUDE_CONFIG_DIR=%q\n' "$CE_PROFILE"
  printf 'export CLAUDE_HOOK_DIR=%q\n' "$CE_PROFILE/hooks"
  printf 'export ENSEMBLE_MEMORY_DIR=%q\n' "$CE_STATE/data/memory"
  printf 'export ENSEMBLE_MEMORY_SOCKET=%q\n' "$CE_STATE/runtime/memory.sock"
  printf 'export ENSEMBLE_MEMORY_HTTP_HOST=127.0.0.1\n'
  printf 'export ENSEMBLE_MEMORY_HTTP_PORT=%q\n' "$memory_port"
  printf 'export FLOSSWARE_MEMORY_URL=%q\n' "http://127.0.0.1:$memory_port"
  printf 'export ENSEMBLE_MEMORY_URL=%q\n' "http://127.0.0.1:$memory_port"
  printf 'export FLOSSWARE_GRAPH_URL=%q\n' "http://127.0.0.1:$graph_port"
  printf 'export ENSEMBLE_GRAPH_URL=%q\n' "http://127.0.0.1:$graph_port"
  printf 'export ENSEMBLE_GRAPH_STORE=%q\n' "$CE_STATE/data/graph.json"
  printf 'export ENSEMBLE_GRAPH_HOST=127.0.0.1\n'
  printf 'export ENSEMBLE_GRAPH_PORT=%q\n' "$graph_port"
  printf 'export ENSEMBLE_LEARNING_DIR=%q\n' "$CE_STATE/data/learning"
  printf 'export ENSEMBLE_LEARNING_SOCKET=%q\n' "$CE_STATE/runtime/learning.sock"
  printf 'export ENSEMBLE_THOMPSON_STATE_FILE=%q\n' "$CE_STATE/data/thompson-sampling-state.json"
  printf 'export ENSEMBLE_THOMPSON_SOCKET=%q\n' "$CE_STATE/runtime/thompson.sock"
  printf 'export ENSEMBLE_HTTP_HOST=127.0.0.1\n'
  printf 'export ENSEMBLE_HTTP_PORT=%q\n' "$gateway_port"
  printf 'export ENSEMBLE_GATEWAY_URL=%q\n' "http://127.0.0.1:$gateway_port"
}

dev_setup() {
  dev_paths
  command -v python3 >/dev/null || { echo "ERROR: python3 is required" >&2; return 1; }
  python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' || {
    echo "ERROR: Python 3.11 or newer is required" >&2; return 1;
  }
  command -v node >/dev/null || { echo "ERROR: Node.js 22 or newer is required" >&2; return 1; }
  node -e 'const [major] = process.versions.node.split(".").map(Number); process.exit(major >= 22 ? 0 : 1)' || {
    echo "ERROR: Node.js 22 or newer is required" >&2; return 1;
  }
  command -v claude >/dev/null || { echo "ERROR: Install Claude Code before setting up CE hooks" >&2; return 1; }
  [[ -f "$ROOT/requirements.txt" ]] || { echo "ERROR: requirements.txt is missing from $ROOT" >&2; return 1; }
  mkdir -p "$(dirname "$CE_PROFILE")" "$(dirname "$CE_STATE")" "$(dirname "$CE_VENV")"
  mkdir -p "$CE_PROFILE/hooks" "$CE_STATE"/{runtime,logs,data/memory,data/learning}
  chmod 700 "$CE_PROFILE" "$CE_PROFILE/hooks" "$CE_STATE" "$CE_STATE/runtime" "$CE_STATE/data" "$CE_STATE/data/memory" "$CE_STATE/data/learning"
  if [[ ! -x "$CE_VENV/bin/python" ]]; then
    python3 -m venv "$CE_VENV"
  fi
  "$CE_VENV/bin/python" -m pip install --disable-pip-version-check -r "$ROOT/requirements.txt"
  ENSEMBLE_CLAUDE_CODE_CONFIG_DIR="$CE_PROFILE" CLAUDE_CONFIG_DIR="$CE_PROFILE" \
    bash "$ROOT/tools/claude-config/bin/claude-config" install --non-interactive
  echo "CE development environment ready."
  echo "  Source: $ROOT"
  echo "  Virtualenv: $CE_VENV"
  echo "  Isolated profile: $CE_PROFILE"
  echo "  Isolated service state: $CE_STATE"
  echo '  Start each service in a separate terminal after running: eval "$(tools/ce dev env)"'
}

dev_run() {
  local service target
  service="${1:-}"
  [[ -n "$service" ]] || { echo "Usage: tools/ce dev run memory|thompson|learning|graph|gateway" >&2; return 2; }
  dev_paths
  [[ -x "$CE_VENV/bin/python" ]] || { echo "ERROR: run 'tools/ce dev setup' first" >&2; return 1; }
  mkdir -p "$CE_PROFILE/hooks" "$CE_STATE"/{runtime,logs,data/memory,data/learning}
  chmod 700 "$CE_PROFILE" "$CE_PROFILE/hooks" "$CE_STATE" "$CE_STATE/runtime" "$CE_STATE/data" "$CE_STATE/data/memory" "$CE_STATE/data/learning"
  eval "$(dev_exports)"
  case "$service" in
    memory) target="memory-service/memory_service.py" ;;
    thompson) target="thompson-service/thompson_service.py" ;;
    learning) target="learning-service/learning_service.py" ;;
    graph) target="graph-service/graph_service.py" ;;
    gateway) target="server/ensemble_server.py" ;;
    *) echo "Unknown CE development service: $service" >&2; return 2 ;;
  esac
  [[ -f "$ROOT/$target" ]] || { echo "ERROR: service entry point is missing: $ROOT/$target" >&2; return 1; }
  cd "$ROOT"
  export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
  exec "$CE_VENV/bin/python" "$ROOT/$target"
}

if [[ $# -eq 0 ]]; then usage; exit 0; fi
command="$1"
shift
case "$command" in
  doctor)
    exec "$ROOT/tools/claude-config/bin/claude-config" doctor "$@"
    ;;
  diagnose)
    exec python3 "$ROOT/scripts/ce-diagnose.py" "$@"
    ;;
  dev)
    subcommand="${1:-}"
    [[ $# -gt 0 ]] && shift
    case "$subcommand" in
      setup) [[ $# -eq 0 ]] || { echo "Usage: tools/ce dev setup" >&2; exit 2; }; dev_setup ;;
      env) [[ $# -eq 0 ]] || { echo "Usage: tools/ce dev env" >&2; exit 2; }; dev_exports ;;
      run) dev_run "$@" ;;
      *) echo "Usage: tools/ce dev setup|env|run SERVICE" >&2; exit 2 ;;
    esac
    ;;
  *)
    echo "Unknown CE command: $command" >&2
    usage >&2
    exit 2
    ;;
esac
