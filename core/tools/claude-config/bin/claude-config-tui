#!/usr/bin/env python3
from pathlib import Path
import curses,subprocess

ROOT=Path(__file__).resolve().parents[1]
CLI=ROOT/"bin"/"claude-config"

try:
    from curses_tui import ThemeManager
    from curses_tui.geometry import Rect
    from curses_tui.windows import Window,WindowManager
except ImportError as exc:
    raise SystemExit("curses-tui is required for the TUI; use the CLI if unavailable") from exc

def run_cli(*args):
    p=subprocess.run([str(CLI),*args],text=True,capture_output=True,check=False)
    return (p.stdout+p.stderr).strip()

def main_screen(stdscr):
    curses.curs_set(0); stdscr.keypad(True); ThemeManager.load("dark").apply(stdscr)
    state={"message":run_cli("detect")}
    def render(win,_):
        win.erase(); win.box()
        lines=["FlossWare Claude Configuration","","[i] Install / Upgrade","[p] Plan","[v] Verify","[d] Doctor","[u] Uninstall","[q] Quit","","Status:"]+state["message"].splitlines()
        for y,line in enumerate(lines[:max(1,win.getmaxyx()[0]-2)],1):
            try: win.addnstr(y,2,line,max(1,win.getmaxyx()[1]-4))
            except curses.error: pass
    h,w=stdscr.getmaxyx(); manager=WindowManager(w,h)
    manager.add(Window("Claude Config",Rect(1,1,max(24,w-2),max(10,h-2)),movable=False,resizable=True,draw_callback=render))
    while True:
        stdscr.erase(); h,w=stdscr.getmaxyx(); manager.resize_screen(w,h); manager.draw(stdscr); curses.doupdate()
        key=stdscr.getch()
        if key in (ord("q"),ord("Q"),27): return
        if key in (ord("i"),ord("I")): state["message"]=run_cli("install")
        elif key in (ord("p"),ord("P")): state["message"]=run_cli("plan")
        elif key in (ord("v"),ord("V")): state["message"]=run_cli("verify")
        elif key in (ord("d"),ord("D")): state["message"]=run_cli("doctor")
        elif key in (ord("u"),ord("U")): state["message"]=run_cli("uninstall")

if __name__=="__main__": curses.wrapper(main_screen)
