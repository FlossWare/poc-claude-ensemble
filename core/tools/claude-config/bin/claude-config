#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
source "$ROOT/lib/core.sh"
source "$ROOT/lib/upgrade.sh"
cmd="help"; [ "$#" -gt 0 ] && cmd="$1" && shift
case "$cmd" in
  detect) detect "$@";;
  plan) plan;;
  sync) sync_memory "$@";;
  watch) watch_memory "$@";;
  install) install "$@";;
  upgrade) upgrade "$@";;
  verify) verify;;
  doctor) doctor "$@";;
  uninstall) uninstall;;
  rag-config) exec python3 "$CC_ROOT/lib/rag_config.py" "$@";;
  outcome) exec python3 "$CC_REPO_ROOT/tools/record_workflow_outcome.py";;
  *) cat <<'EOF'
claude-config
  detect [true]     Inspect current configuration
  plan              Show proposed changes
  install           Install or upgrade safely
  upgrade           Alias for install
  verify            Validate installation
  doctor            Diagnose configuration
  sync              Reconcile Claude Markdown into Memory
  watch             Watch Claude Markdown and ingest changes
  uninstall         Remove FlossWare-managed configuration
  rag-config        Show or set profile-scoped RAG hook behavior
  outcome           Submit an evidence-backed workflow outcome from stdin JSON
Install options: --dry-run --force --non-interactive
EOF
  ;;
esac
