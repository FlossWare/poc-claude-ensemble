#!/usr/bin/env bash
# UserPromptSubmit hook: load RH memory on every prompt (no embedding services)
set -euo pipefail

# Capture the hook payload (UserPromptSubmit JSON on stdin) before anything
# else consumes it. Guard against a TTY so manual runs don't block forever.
HOOK_INPUT=""
if [ ! -t 0 ]; then
    HOOK_INPUT="$(cat || true)"
fi

# MEMORY FIRST: Display relevant memory on every prompt
MEMORY_FILE="$HOME/Development/redhat/scm/gitlab/cee/sfloess/claude-global-skills/memory/MEMORY.md"
if [ -f "$MEMORY_FILE" ]; then
    echo "📋 MEMORY LOADED (consult these before deciding):" >&2
    head -30 "$MEMORY_FILE" >&2
    echo "" >&2
fi

# MEMORY SEARCH: surface the top matching memory files for this prompt.
# Fully optional - silent no-op if the cache, module, or python3 is absent.
SEARCH_HOOK="$HOME/.claude/scripts/memory_search_hook.py"
if [ -n "$HOOK_INPUT" ] && [ -f "$SEARCH_HOOK" ] && command -v python3 >/dev/null 2>&1; then
    printf '%s' "$HOOK_INPUT" | timeout 5s python3 "$SEARCH_HOOK" || true
fi

# Return empty response (hook doesn't modify the prompt)
echo '{}'
