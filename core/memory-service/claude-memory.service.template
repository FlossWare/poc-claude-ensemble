[Unit]
Description=Memory Service - Central memory authority for Claude Code sessions
Documentation=file://%h/.config/systemd/user/claude-memory.service.d/README.md
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/env python3 %REPO_PATH%/memory-service/memory_service.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=claude-ensemble-memory-service

# User service runs as the current user.
# RuntimeDirectory creates %t/claude-ensemble under the user's XDG runtime dir.
RuntimeDirectory=claude-ensemble
RuntimeDirectoryMode=0700
UMask=0077

# Optional per-user portable configuration.
EnvironmentFile=-%h/.config/claude-ensemble/environment

# Environment
Environment="PATH=%h/.local/bin:%REPO_PATH%/tools:/usr/local/bin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"

# Resource limits
MemoryLimit=512M
CPUQuota=50%

[Install]
WantedBy=default.target
