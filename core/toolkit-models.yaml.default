# Legacy RH toolkit model template, retained for compatibility only.
# This file is not read by the active Claude Ensemble runtime.
# The active runtime invokes Claude Code and accepts only haiku, sonnet, opus,
# or concrete Claude model IDs. Do not add external provider entries here.

user: "${USER}"
workspace: redhat
description: Model aliases available through the installed Claude Code runtime

models:
  haiku:
    provider: claude-code
    id: haiku
    available: true
    capabilities: [fast-review, analysis]
  sonnet:
    provider: claude-code
    id: sonnet
    available: true
    capabilities: [code-review, documentation, testing]
  opus:
    provider: claude-code
    id: opus
    available: true
    capabilities: [arbiter, code-review, design]

skill_defaults:
  rh-pr-review:
    models: [opus, sonnet, haiku]
    arbiter: opus
  rh-doc:
    models: [opus, sonnet, haiku]
    arbiter: opus
  rh-release-notes:
    models: [opus, sonnet, haiku]
    arbiter: opus
  rh-pr-review-auto:
    models: [opus, sonnet, haiku]
    arbiter: opus
  rh-doc-auto:
    models: [opus, sonnet, haiku]
    arbiter: opus

thompson_routing:
  enabled: true
  required_capability: 0.7
