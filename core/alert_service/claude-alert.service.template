[Unit]
Description=Alert Service - Central alert service for Claude Code monitoring
Documentation=file://%h/.config/systemd/user/claude-alert.service.d/README.md
After=network.target claude-learning.service
Wants=claude-learning.service

[Service]
Type=simple
ExecStart=/usr/bin/env python3 %REPO_PATH%/alert_service/alert_service.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=claude-ensemble-alert-service

# Optional per-user portable configuration.
EnvironmentFile=-%h/.config/claude-ensemble/environment

# Environment
Environment="PATH=%h/.local/bin:%REPO_PATH%/tools:%REPO_PATH%:/usr/local/bin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="ENSEMBLE_REPO_ROOT=%REPO_PATH%"

# Resource limits
MemoryLimit=256M
CPUQuota=25%

[Install]
WantedBy=default.target
